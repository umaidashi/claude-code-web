PORT=3000

# Database Configuration
# DATABASE_TYPE: 'postgres' or 'turso'
DATABASE_TYPE=postgres

# PostgreSQL Database (used when DATABASE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hono_api

# Turso Database (used when DATABASE_TYPE=turso)
# For local development, use file:local.db
# For production, use your Turso database URL
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=your-turso-auth-token-here
